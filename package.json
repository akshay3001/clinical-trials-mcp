{
  "name": "clinical-trials-mcp",
  "version": "2.0.0",
  "description": "MCP server for searching and analyzing clinical trials from ClinicalTrials.gov",
  "type": "module",
  "main": "dist/mcp/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start:mcp": "node dist/mcp/server.js",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akshay3001/clinical-trials-mcp.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^11.7.0",
    "papaparse": "^5.4.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.15",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
